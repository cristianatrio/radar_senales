		annotation SummarizationSetBy = User

	partition dim_fecha = m
		mode: import
		source =
				let
				    Tabla = CargarCsv("dim_fecha.csv", {{"fecha", type date}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"anio_mes", type text}, {"dia", Int64.Type}, {"dia_semana", Int64.Type}, {"es_habil", type logical}})
				in
