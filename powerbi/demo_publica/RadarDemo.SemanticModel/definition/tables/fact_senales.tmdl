	/// Día UTC en que corrió el radar y generó la señal. Eje diario de la evolución de señales.
	column 'Día de corrida' = DATE ( YEAR ( [generado_utc] ), MONTH ( [generado_utc] ), DAY ( [generado_utc] ) )
		dataType: dateTime
		formatString: dd mmm
		lineageTag: 989ba19c-d1e7-5d87-b24d-f18bb8cf2a7d
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Estado del dato en palabras (Válido, Desactualizado, Error del proveedor, Sin datos); deriva de estado_dato.
	column 'Estado del dato' = SWITCH ( [estado_dato], "valido", "Válido", "obsoleto", "Desactualizado", "error_proveedor", "Error del proveedor", "sin_datos", "Sin datos", "historial_insuficiente", "Historial insuficiente", "dato_invalido", "Dato inválido", [estado_dato] )
		dataType: string
		lineageTag: ce1b0e35-b1f7-561a-be64-9bc9a7599478
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Data status in words (English pages); derived from estado_dato.
	column 'Data status' = SWITCH ( [estado_dato], "valido", "Valid", "obsoleto", "Stale", "error_proveedor", "Provider error", "sin_datos", "No data", "historial_insuficiente", "Insufficient history", "dato_invalido", "Invalid data", [estado_dato] )
		dataType: string
		lineageTag: f641c832-774e-5a64-9771-3c75b0e7e299
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Run day as English text (dd mmm) for the daily chart on the English pages; sorted by Día de corrida.
	column 'Run day' = FORMAT ( [Día de corrida], "dd mmm", "en-US" )
		dataType: string
		lineageTag: 4ba61589-dc60-5bb1-a7ed-8e9fa47b9d48
		summarizeBy: none
		sortByColumn: 'Día de corrida'

		annotation SummarizationSetBy = User

	partition fact_senales = m
		mode: import
		source =
				let
				    Tabla = CargarCsv("fact_senales.csv", {{"id", Int64.Type}, {"run_id", type text}, {"ticker", type text}, {"tipo", type text}, {"fuente", type text}, {"timeframe", type text}, {"mercado", type text}, {"moneda", type text}, {"estado_dato", type text}, {"generado_utc", type datetime}, {"capturado_utc", type datetime}, {"vela_utc", type datetime}, {"precio", type number}, {"señal", type text}, {"fuerza", Int64.Type}, {"rsi", type number}, {"macd_hist", type number}, {"vol_relativo", type number}, {"ma_corta", type number}, {"ma_larga", type number}, {"motivos", type text}, {"es_ultima", type logical}, {"cambio_senal", type logical}, {"fecha", type date}})
				in
				    Tabla

	annotation PBI_ResultType = Table

