{
  "name": "RadarTheme",
  "dataColors": [
    "#4F46E5",
    "#16A34A",
    "#DC2626",
    "#94A3B8",
    "#0EA5E9",
    "#F59E0B"
  ],
  "foreground": "#1B2430",
  "background": "#FFFFFF",
  "tableAccent": "#4F46E5",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#1B2430"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 13,
      "color": "#64748B"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 32,
      "color": "#1B2430"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1B2430"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 16,
            "fontColor": {
              "solid": {
                "color": "#1B2430"
              }
            },
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6EAF0"
              }
            },
            "radius": 10,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 93
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 13,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 13,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 13,
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FB"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "value": [
          {
            "fontSize": 32,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1B2430"
              }
            },
            "bold": true
          }
        ],
        "label": [
          {
            "fontSize": 13,
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "showMarker": false,
            "strokeShow": true,
            "strokeWidth": 3
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [
          {
            "showMarker": false,
            "strokeShow": true,
            "strokeWidth": 3
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "textSize": 13,
            "fontColor": {
              "solid": {
                "color": "#1B2430"
              }
            }
          }
        ],
        "header": [
          {
            "show": false
          }
        ],
        "general": [
          {
            "responsive": false
          }
        ]
      }
    }
  }
