/// Calendario diario (UTC) que cubre todas las velas y corridas. Marcada como tabla de fechas.
table dim_fecha
	lineageTag: 4a7b493e-c75d-5087-842d-6057cb7b7978
	dataCategory: Time

	column fecha
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 56bde62a-361e-590c-84be-29b542699d2a
		summarizeBy: none
		sourceColumn: fecha

		annotation SummarizationSetBy = User

	column anio
