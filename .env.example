# Plantilla de variables de entorno. Copiá los nombres a tu entorno local
# (o a un .env que NO se versiona). Dejá vacío lo que no uses.
#
# Windows (PowerShell, solo para la sesión actual):
#   $env:TELEGRAM_TOKEN = "..."
# Windows (persistente para tu usuario):
#   setx TELEGRAM_TOKEN "..."
#
# El programa NO lee este archivo automáticamente: es documentación.

# Telegram (opcional): token del bot creado con @BotFather y tu chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Ripio (opcional): API key de SOLO LECTURA.
RIPIO_API_KEY=
RIPIO_SECRET_KEY=
